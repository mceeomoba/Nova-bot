{
  "name": "automaton-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "NOVA AUTOMATON self-hosted backend for autonomous agents: wallet, x402 facilitator, local llama.cpp inference gateway (OpenRouter fallback), local VM execution as a standalone service.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke:groups": "tsx smoke_groups.ts",
    "test": "node scripts/run-tests.mjs",
    "telegram:control-bot": "node telegram/control-bot.ts",
    "telegram:notifier-bot": "node telegram/notifier-bot.ts"
  },
  "dependencies": {
    "@vscode/vsce": "^3.2.1",
    "better-sqlite3": "^11.3.0",
    "bs58": "^6.0.0",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "multer": "^2.3.0",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.20.2",
    "tweetnacl": "^1.0.3",
    "ulid": "^2.3.0",
    "viem": "^2.21.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.5.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
