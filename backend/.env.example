# --- Server ---
PORT=8000
# Shared secret agents/clients must send as `x-backend-key` header on every request.
BACKEND_API_KEY=change-me-to-a-long-random-string
# Separate secret for YOU, sent as `x-admin-key`. Never give this to an agent.
ADMIN_API_KEY=change-me-to-a-different-long-random-string

# --- Local inference (llama.cpp server, this VM) ---
# Primary model. Must point at an OpenAI-compatible /v1 root — this is
# exactly what `llama-server` exposes by default.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL_NAME=qwen3-4b
# Optional shared SmolVLM2 endpoint for browser screenshots. Keep it private.
VISION_MODEL_BASE_URL=http://127.0.0.1:8081/v1
# Generate a long random value on the VM; never commit a real key.
VISION_MODEL_API_KEY=
LOCAL_MODEL_TIMEOUT_MS=60000
# true = local model first, OpenRouter only as a fallback on failure
# (the current setup). Set to false later if you migrate off the VM
# and want to go straight to OpenRouter.
USE_LOCAL_MODEL_PRIMARY=true

# --- OpenRouter (fallback only, see USE_LOCAL_MODEL_PRIMARY above) ---
# Optional while running local-first — leave unset and the fallback is
# simply skipped (a local failure surfaces as an error). Fill this in
# whenever you're ready to have a real fallback, or to migrate off the
# VM entirely later.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=ox-alpha
# Price you charge agents per 1K tokens (in USDC). The local model costs
# you nothing to run, but this still applies — it's your platform's own
# usage pricing, not a pass-through of provider cost.
PRICE_PER_1K_TOKENS_USDC=0.01
# Hard cap on inference spend per agent per rolling 24h — enforced before
# every request, paid or not.
MAX_INFERENCE_SPEND_USDC_PER_AGENT_PER_DAY=2

# --- Facilitator / on-chain settlement ---
# This wallet pays gas on Base for every settled payment. Fund it with ETH.
FACILITATOR_PRIVATE_KEY=0xabc...
CHAIN_NETWORK=base-sepolia
# base-sepolia while testing, base for real USDC once you trust the flow

# --- Local VM execution ---
# Directory agents are allowed to read/write/execute in. Never allow "/".
# This is bind-mounted into the sandbox container at /workspace.
VM_WORKDIR=/root/workspace
# Command allowlist, comma separated. Empty = allow any (NOT recommended).
# "bash" is required — the agent client wraps every exec call in
# `bash -c "..."` so shell syntax (pipes, &&, redirects) works.
VM_ALLOWED_COMMANDS=bash,node,python3,git,curl

# --- Docker sandbox (all /vm/exec calls run inside this, not on the host) ---
DOCKER_SANDBOX_IMAGE=automaton-sandbox:latest
# "none" = no network at all (default, safest). Set to "bridge" only if
# the agent genuinely needs outbound network from inside its sandbox.
DOCKER_SANDBOX_NETWORK=none
DOCKER_MEMORY_LIMIT_MB=512
DOCKER_CPU_QUOTA=1
DOCKER_PIDS_LIMIT=128
EXEC_TIMEOUT_MS=30000
EXEC_MAX_OUTPUT_BYTES=1048576

# --- Multi-sandbox (isolated per-agent/per-child containers) ---
# Tuned for THIS deployment's 16GB/4-core VM (corrected from an
# earlier 8GB assumption — see the deploy/ conversation this was
# worked out in), not left at upstream's original defaults (3/4/8192,
# sized for a bigger box than even this one). Backend + agent + both
# llama-server instances commit ~5.9GB of the 16GB total, leaving
# ~10GB free. createNamedSandbox() passes memoryMb straight into
# Docker's real Memory cgroup limit — this is a live ceiling, not just
# a quota number — and nothing checks total sandbox memory in use
# against host capacity, so this is the number that actually protects
# the box. With 3 concurrent sandboxes max at 1024MB each, worst case
# is +3GB on top of baseline — comfortable, with swap still there as a
# last-resort safety net, not the first line of defense.
MAX_SANDBOXES_PER_AGENT=3
MAX_SANDBOX_VCPU=4
MAX_SANDBOX_MEMORY_MB=1024
MIN_SANDBOX_MEMORY_MB=512

# Both of these were missing from this file entirely before — real,
# consumed config (config.ts), just undocumented. Unlike the explicit-
# request sandboxes above, department/project environment sandboxes
# are created once and stay alive for that department/project's whole
# lifetime (torn down only on explicit retirement, not on idle) — so
# this ceiling is really "how many 512MB sandboxes can be alive at
# once", not a burst limit.
#
# On this 16GB box: ~10GB is left after backend+agent+both llama-server
# instances, and after budgeting 3GB for the explicit-request pool
# above, roughly 12 persistent 512MB sandboxes is comfortable. That's
# less than the new 20-department ceiling below (if all 20 departments
# were simultaneously active with their own environment, that alone
# would be 20 sandboxes, more than this 12) — meaning this is a real,
# separate hardware backstop, not just a mirror of the business-logic
# ceiling below. A founding attempt past what 16GB can actually hold
# gets a 403 from environment.ts's own sandbox quota, independent of
# whether the department-count ceiling below still has room.
MAX_ENVIRONMENT_SANDBOXES_PER_AGENT=12
MAX_SANDBOX_DISK_GB=20

# --- Headcount ceilings, per explicit instruction: max 20 departments
# per agent, max 20 permanent workers per department, minimum 10
# permanent workers per department (floor, enforced on removal —
# see subagents.ts's /:id/kill and config.ts's own comment on
# minPermanentWorkersPerDepartment for exactly how). Temp/project
# workers are governed by the separate ceiling right below, untouched.
DEFAULT_MAX_DEPARTMENTS_PER_AGENT=20
DEFAULT_MAX_WORKERS_PER_DEPARTMENT=20
MIN_PERMANENT_WORKERS_PER_DEPARTMENT=10
DEFAULT_MAX_TEMP_WORKERS_PER_DEPARTMENT=100

# --- Ports (public URLs for anything an agent exposes) ---
# This MUST be your VM's real public IP (or domain) — it's what gets
# printed in links the agent may share outside the VM. Everything else
# in this file should stay on 127.0.0.1; this one is the exception.
PUBLIC_BASE_URL=http://YOUR_ALIBABA_VM_PUBLIC_IP:8000
MAX_EXPOSED_PORTS_PER_SANDBOX=3

# --- ERC-8004 (public on-chain agent registry, optional) ---
# Only needed if you want agents to be independently verifiable by
# strangers, not just tracked in your own agents table. Registering
# costs a small amount of ETH gas on whichever CHAIN_NETWORK you're
# using — fund the specific agent wallet before it calls
# register_erc8004, not this backend's own wallet.
#
# Leave both unset to use viem's public RPC and the canonical Base
# deployment baked into erc8004.ts. Override only if you're pointing at
# a different registry deployment or want your own RPC for reliability.
# ERC8004_RPC_URL=https://mainnet.base.org
# ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432

# Reputation Registry has a published canonical address, same pattern as
# Identity above — safe to leave unset unless you're pointing elsewhere.
# Used by the marketplace dispute path (marketplace.ts) to mirror a
# buyer's flag on-chain; purely additive, never required for /invoke or
# /flag to work.
# ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# Validation Registry has NO published canonical address yet (spec
# section still under active revision as of this writing) — unlike the
# two above, there is no baked-in default. Leave unset to keep the
# opt-in validator hook (listings' validatorAddress field) disabled.
# Only set this once you've independently confirmed which deployment you
# trust; see erc8004Trust.ts's docblock.
# ERC8004_VALIDATION_REGISTRY=

# --- Database ---
DB_PATH=./data/backend.db

# Treasury address that receives inference usage payments
TREASURY_ADDRESS=0xYourPlatformTreasuryAddress

# --- Social Relay (self-hosted replacement for NOVA's the legacy hosted social relay) ---
# Point an automaton's `socialRelayUrl` config at
# {PUBLIC_BASE_URL}/social to use this instead. No agent-side code
# changes needed — wire protocol matches agent/src/social/*.ts exactly.
# All of these are safe to leave at their defaults, which mirror the
# agent client's own MESSAGE_LIMITS.
# SOCIAL_MAX_CONTENT_BYTES=64000
# SOCIAL_MAX_TOTAL_BYTES=128000
# SOCIAL_REPLAY_WINDOW_MS=300000
# SOCIAL_MAX_OUTBOUND_PER_HOUR=100
# SOCIAL_POLL_DEFAULT_LIMIT=50
# SOCIAL_POLL_MAX_LIMIT=200
# SOCIAL_MAX_DELIVERY_RETRIES=5
# SOCIAL_CLAIM_TIMEOUT_MS=600000
# SOCIAL_MESSAGE_RETENTION_MS=2592000000

# --- PTY sessions (src/ptyService.ts) ---
# Max concurrent interactive PTY sessions any one agent may hold open.
MAX_PTY_SESSIONS_PER_AGENT=3
# A session nobody has written to or read from in this many ms gets
# force-closed by a background sweep, even if the agent forgot about it.
PTY_IDLE_TIMEOUT_MS=600000

# --- Domain Management (architecture-agent.md §4h, next-phase.md Phase 9) ---
# One apex domain, shared across every Agent — see next-phase.md's
# Phase 9 design-decisions note. Leave both Cloudflare vars unset
# until deploy/domain-stack (Phase 9b) is actually up; the backend
# starts fine either way and just warns once that Domain Management
# features are unavailable (config.ts's optionalSecret()).
DOMAIN_APEX=novamail.store
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# Phase 9c: this backend's own path into the Phase 9b domain-stack
# (deploy/domain-stack/). Defaults match that stack's docker-compose.yml
# exactly (fixed container_names, conf.d/ one level up from a
# backend/ working directory) — only override if you moved the stack
# or run this backend from somewhere else.
# DOMAIN_STACK_CONF_D_DIR=../deploy/domain-stack/nginx/conf.d
# DOMAIN_STACK_NGINX_CONTAINER=domain-stack-nginx
# DOMAIN_STACK_CERTBOT_CONTAINER=domain-stack-certbot
# Required before provision_subdomain will actually issue a cert —
# Let's Encrypt account email, refused unset rather than silently
# using --register-unsafely-without-email.
# DOMAIN_STACK_CERTBOT_EMAIL=
# The VM's real public IP — provision_subdomain's Cloudflare A record
# has to point somewhere, and nothing here auto-detects it reliably
# (a VM can have several interfaces). No default on purpose; domains.ts
# refuses to provision rather than guess. (Missing from earlier
# versions of this file — config.ts always read it via optionalSecret,
# it just wasn't documented here.)
# DOMAIN_STACK_PUBLIC_IP=

# --- Mailcow (mailbox-side counterpart to Cloudflare above, Phase 9d) ---
# Only needed if you're standing up the Mailcow half of Domain
# Management as a sibling deployment (see README.md) — leave both unset
# to keep that disabled. (Also missing from earlier versions of this
# file for the same reason as DOMAIN_STACK_PUBLIC_IP above.)
# MAILCOW_API_URL=
# MAILCOW_API_KEY=

# Optional founder-controlled mirror of nova-backend. Keep token secret.
GITHUB_SYNC_ENABLED=false
GITHUB_SYNC_OWNER=segz7448
GITHUB_SYNC_REPO=nova-backend
GITHUB_SYNC_BRANCH=main
GITHUB_TOKEN=
GITHUB_SYNC_INTERVAL_MS=30000
GITHUB_SYNC_ROOT=.
GITHUB_RESTART_COMMAND=""

# --- Telegram bots (backend/telegram/control-bot.ts, notifier-bot.ts) ---
# Moved into this repo/env file so they're not a disconnected third
# folder with their own separate config — they run as their own
# processes (deploy/telegram-*.service), but read from this same file
# now, and reuse ADMIN_API_KEY above rather than needing their own copy
# of it. See backend/telegram/*.ts's own header comments for full setup
# details (getting a bot token from @BotFather, finding your Telegram
# user id, setting up Topics in the group, etc.) — kept there rather
# than duplicated here since they're right next to the code that
# actually reads them.

# From @BotFather: message it, send /newbot, follow the prompts. Same
# token can run both bots (separate processes, same bot identity).
TG_BOT_TOKEN=

# control-bot.ts (the /kill, /unfreeze, /status, /agents kill switch).
# Now that these bots live alongside the backend rather than
# potentially running elsewhere, this defaults to localhost — change it
# back to a public URL if you ever do run this bot from somewhere else.
BACKEND_ADMIN_URL=http://127.0.0.1:8000/admin/control

# Comma-separated Telegram numeric user IDs allowed to run commands —
# the actual security boundary (a leaked bot token without this set is
# a leaked kill switch over real money). Get your numeric id from
# @userinfobot. Empty = every command silently rejected (fails closed).
ADMIN_TELEGRAM_USER_IDS=

# notifier-bot.ts (the per-department digest/alert bot)
TG_CHAT_ID=
BACKEND_EVENTS_URL=http://127.0.0.1:8000/admin/control/events
BACKEND_REPORTS_URL=http://127.0.0.1:8000/admin/control/reports
# DIGEST_INTERVAL_MS=45000
# REPORTS_POLL_INTERVAL_MS=300000
TOPIC_FINANCE=
TOPIC_CEO=
TOPIC_SECURITY=
TOPIC_MARKETING=
TOPIC_OPPORTUNITY=
# TG_REPORTS_CHAT_ID=
